# Server
PORT=8080
DEBUG=true

# Database (PostgreSQL)
DB_HOST=localhost
DB_USER=reader
DB_PASSWORD=reader
DB_NAME=reader
DB_PORT=5432
DB_SSLMODE=disable

# Storage (S3-Compatible)
# Providers: AWS, Cloudflare R2, GCP Storage
S3_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
S3_REGION=auto
S3_ACCESS_KEY_ID=your_access_key
S3_SECRET_ACCESS_KEY=your_secret_key
S3_BUCKET=reader-storage
S3_USE_PATH_STYLE=false

# CDN
CDN_URL_PREFIX=https://cdn.example.com
